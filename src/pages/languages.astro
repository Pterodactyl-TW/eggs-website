---
import Layout from "../layouts/Layout.astro";
import { ICONS } from "../lib/icons.js";
---
<Layout title="通用語言" active="languages" description="瀏覽所有繁體中文化的通用語言 Egg，涵蓋 Python、Node.js、Go 等。">
  <div class="breadcrumb"><a href="/">首頁</a> / 通用語言</div>

  <div class="page-header">
    <div class="page-icon icon-wrap" set:html={ICONS.code} />
    <div>
      <h1>通用語言 Eggs</h1>
      <p class="page-subtitle" id="egg-count-label">載入中...</p>
    </div>
  </div>

  <section class="controls">
    <div class="inline-search">
      <input id="search-input" type="text" placeholder="搜尋通用語言名稱...（例如 Python、Node.js、Go）" autocomplete="off">
    </div>
    <div id="category-filters" class="filter-group" role="group" aria-label="分類篩選"></div>
  </section>

  <section id="status" class="status"></section>
  <section id="egg-grid" class="egg-grid"></section>
</Layout>

<script>
  import { mountEggBrowser } from "../lib/egg-browser.js";
  mountEggBrowser({
    repoId: "languages",
    gridEl: document.getElementById("egg-grid"),
    statusEl: document.getElementById("status"),
    searchEl: document.getElementById("search-input"),
    categoryFiltersEl: document.getElementById("category-filters"),
    countLabelEl: document.getElementById("egg-count-label"),
  });
</script>
