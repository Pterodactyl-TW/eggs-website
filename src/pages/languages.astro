---
import Layout from "../layouts/Layout.astro";
---
<Layout title="語言" active="languages" description="瀏覽所有繁體中文化的通用語言 Egg，涵蓋 Python、Node.js、Go 等。">
  <section class="hero">
    <h1>💻 語言</h1>
    <p>來自 <a href="https://github.com/Pterodactyl-TW/generic-eggs" target="_blank" rel="noopener">generic-eggs</a> 倉庫的繁體中文化通用語言 Egg。</p>
    <div class="search-bar">
      <input id="search-input" type="text" placeholder="搜尋語言名稱...（例如 Python、Node.js、Go）" autocomplete="off">
    </div>
  </section>

  <section class="controls">
    <div id="category-filters" class="filter-group" role="group" aria-label="分類篩選"></div>
  </section>

  <section id="status" class="status"></section>
  <section id="egg-grid" class="egg-grid"></section>
</Layout>

<script>
  import { mountEggBrowser } from "../lib/egg-browser.js";
  mountEggBrowser({
    repoId: "languages",
    gridEl: document.getElementById("egg-grid"),
    statusEl: document.getElementById("status"),
    searchEl: document.getElementById("search-input"),
    categoryFiltersEl: document.getElementById("category-filters"),
  });
</script>
