---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Games" active="games" description="瀏覽所有繁體中文化的遊戲伺服器 Egg，涵蓋 Minecraft、ARK、CS 等。">
  <section class="hero">
    <h1>🎮 Games</h1>
    <p>來自 <a href="https://github.com/Pterodactyl-TW/game-eggs" target="_blank" rel="noopener">game-eggs</a> 倉庫的繁體中文化遊戲伺服器 Egg。</p>
    <div class="search-bar">
      <input id="search-input" type="text" placeholder="搜尋遊戲名稱...（例如 Minecraft、Rust、ARK）" autocomplete="off">
    </div>
  </section>

  <section class="controls">
    <div id="category-filters" class="filter-group" role="group" aria-label="分類篩選"></div>
  </section>

  <section id="status" class="status"></section>
  <section id="egg-grid" class="egg-grid"></section>
</Layout>

<script>
  import { mountEggBrowser } from "../lib/egg-browser.js";
  mountEggBrowser({
    repoId: "games",
    gridEl: document.getElementById("egg-grid"),
    statusEl: document.getElementById("status"),
    searchEl: document.getElementById("search-input"),
    categoryFiltersEl: document.getElementById("category-filters"),
  });
</script>
